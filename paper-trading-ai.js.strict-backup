// 🔍 MULTI-MARKET SCANNER - Find the most profitable trading opportunities
class MarketScanner {
    constructor() {
        this.ws = null;
        this.connected = false;
        this.activeMarket = 'SOL/USD';
        
        // Track multiple markets for best opportunities - EXPANDED COVERAGE!
        this.markets = {
            // Major Coins (Top 10)
            'BTC/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'ETH/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'SOL/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'XRP/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'ADA/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            
            // Layer 1s & DeFi Giants
            'AVAX/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'MATIC/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'DOT/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'ATOM/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'LINK/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            
            // Meme Coins (High Volatility)
            'DOGE/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'SHIB/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            
            // DeFi Tokens
            'UNI/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'AAVE/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'MKR/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'COMP/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            
            // Legacy Alts
            'LTC/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: true },
            'BCH/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'ETC/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            
            // Gaming & Metaverse
            'SAND/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'MANA/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'AXS/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            
            // Smart Contract Platforms
            'ALGO/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'FTM/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'NEAR/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            
            // Other Opportunities
            'FIL/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'TRX/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'XLM/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'VET/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false },
            'ICP/USD': { price: 0, volatility: 0, trend: 0, volume: 0, score: 0, history: [], active: false }
        };
        
        this.lastSwitch = Date.now();
        this.switchCooldown = 120000; // 2 minutes between switches
        this.tradeCallback = null;
    }
    
    calculateOpportunityScore(market) {
        const data = this.markets[market];
        if (data.history.length < 20) return 0;
        
        // Score: volatility (50%), trend strength (30%), volume (20%)
        const volScore = Math.min(data.volatility * 20, 1);
        const trendScore = Math.abs(data.trend) * 10;
        const volumeScore = Math.min(data.volume / 50000, 1);
        
        return (volScore * 0.5) + (trendScore * 0.3) + (volumeScore * 0.2);
    }
    
    findBestMarket(isHolding = false) {
        // NEVER switch markets while holding a position!
        if (isHolding) {
            return this.activeMarket;
        }
        
        let bestMarket = this.activeMarket;
        let bestScore = 0;
        
        for (const [market, data] of Object.entries(this.markets)) {
            if (!data.active) continue;
            
            data.score = this.calculateOpportunityScore(market);
            if (data.score > bestScore) {
                bestScore = data.score;
                bestMarket = market;
            }
        }
        
        // Switch if significantly better market found
        const timeSinceSwitch = Date.now() - this.lastSwitch;
        const currentScore = this.markets[this.activeMarket].score;
        
        if (timeSinceSwitch > this.switchCooldown && bestScore > currentScore * 1.3) {
            if (bestMarket !== this.activeMarket) {
                console.log(`\n🔄 MARKET SWITCH: ${this.activeMarket} → ${bestMarket}`);
                console.log(`   Score: ${currentScore.toFixed(3)} → ${bestScore.toFixed(3)} (+${((bestScore/currentScore - 1) * 100).toFixed(0)}%)`);
                this.activeMarket = bestMarket;
                this.lastSwitch = Date.now();
                
                // Activate new market if not active
                if (!this.markets[bestMarket].active) {
                    this.markets[bestMarket].active = true;
                    this.subscribeToMarket(bestMarket);
                }
            }
        }
        
        return bestMarket;
    }
    
    subscribeToMarket(market) {
        if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            this.ws.send(JSON.stringify({
                event: 'subscribe',
                pair: [market],
                subscription: { name: 'trade' }
            }));
        }
    }
    
    connect() {
        return new Promise((resolve) => {
            console.log('🌐 Connecting to Kraken WebSocket...');
            
            this.ws = new WebSocket('wss://ws.kraken.com');
            
            this.ws.on('open', () => {
                console.log('✅ Connected to Kraken WebSocket');
                this.connected = true;
                
                // Subscribe to ALL markets for monitoring
                const allPairs = Object.keys(this.markets);
                this.ws.send(JSON.stringify({
                    event: 'subscribe',
                    pair: allPairs,
                    subscription: { name: 'ticker' }
                }));
                
                // Subscribe to trades on active markets
                const activePairs = Object.keys(this.markets).filter(m => this.markets[m].active);
                this.ws.send(JSON.stringify({
                    event: 'subscribe',
                    pair: activePairs,
                    subscription: { name: 'trade' }
                }));
                
                console.log(`📊 Monitoring ${allPairs.length} markets | Trading ${activePairs.length} active`);
                resolve(true);
            });
            
            this.ws.on('message', (data) => {
                try {
                    const msg = JSON.parse(data);
                    
                    // Ticker updates
                    if (Array.isArray(msg) && msg[2] === 'ticker') {
                        const ticker = msg[1];
                        const pair = msg[3];
                        
                        if (this.markets[pair]) {
                            const price = parseFloat(ticker.c[0]);
                            const volume = parseFloat(ticker.v[1]);
                            
                            this.markets[pair].price = price;
                            this.markets[pair].volume = volume;
                            this.markets[pair].history.push({ price, time: Date.now() });
                            
                            if (this.markets[pair].history.length > 100) {
                                this.markets[pair].history.shift();
                            }
                            
                            // Calculate volatility and trend
                            if (this.markets[pair].history.length >= 30) {
                                const prices = this.markets[pair].history.map(h => h.price);
                                const avg = prices.reduce((a, b) => a + b) / prices.length;
                                
                                // Volatility
                                const variance = prices.reduce((sum, p) => sum + Math.pow(p - avg, 2), 0) / prices.length;
                                this.markets[pair].volatility = Math.sqrt(variance) / avg;
                                
                                // Trend
                                const oldAvg = prices.slice(0, 15).reduce((a, b) => a + b) / 15;
                                const newAvg = prices.slice(-15).reduce((a, b) => a + b) / 15;
                                this.markets[pair].trend = (newAvg - oldAvg) / oldAvg;
                            }
                        }
                    }
                    
                    // Trade updates
                    if (Array.isArray(msg) && msg[2] === 'trade') {
                        const pair = msg[3];
                        if (pair === this.activeMarket && this.tradeCallback) {
                            const trades = msg[1];
                            trades.forEach(trade => {
                                const [price, volume, timestamp, side] = trade;
                                this.tradeCallback({
                                    pair,
                                    price: parseFloat(price),
                                    volume: parseFloat(volume),
                                    side: side === 'b' ? 'buy' : 'sell',
                                    timestamp: parseFloat(timestamp) * 1000
                                });
                            });
                        }
                    }
                } catch (err) {
                    // Ignore parse errors
                }
            });
            
            this.ws.on('error', (err) => {
                console.log('⚠️ WebSocket error:', err.message);
            });
            
            this.ws.on('close', () => {
                console.log('🔌 Connection closed. Reconnecting...');
                this.connected = false;
                setTimeout(() => this.connect(), 5000);
            });
        });
    }
    
    getCurrentPrice() {
        return this.markets[this.activeMarket].price || 0;
    }
    
    getPriceHistory() {
        return this.markets[this.activeMarket].history || [];
    }
    
    getMarketData() {
        const market = this.markets[this.activeMarket];
        return {
            price: market.price,
            volatility: market.volatility,
            trend: market.trend,
            volume: market.volume,
            score: market.score,
            history: market.history
        };
    }
}

